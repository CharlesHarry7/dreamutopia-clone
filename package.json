{
  "name": "dreamutopia-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "npm run lint && npm run build",
    "verify:worker": "npm run verify && npm run cf:build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "npm run cf:preview",
    "deploy": "npm run cf:deploy",
    "cf:secret:kie": "wrangler secret put KIE_API_KEY",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf-typegen": "npm run cf:typegen",
    "db:schema": "wrangler d1 execute dreamutopia-db --remote --file=schema.sql",
    "db:migrate": "wrangler d1 execute dreamutopia-db --remote --file=migrations/001_generations_kie.sql && wrangler d1 execute dreamutopia-db --remote --file=migrations/002_gallery_unique.sql && wrangler d1 execute dreamutopia-db --remote --file=migrations/003_referrals_credits.sql && wrangler d1 execute dreamutopia-db --remote --file=migrations/004_template_hardening.sql",
    "check:health": "node scripts/check-health.mjs",
    "pages:legacy": "echo \"A-line snapshot: legacy/out + legacy/functions. B-line is Workers (see B-LINE.md). Do not cut over Pages from this script.\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.122.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
